# === Fengchi (sched_ext/SCX + OPLUS HMBIRD) kernel config ===
# !! CONFIG_DEBUG_INFO MUST stay off.  With it on, .eh_frame grows and
# !! ~267 KB of it lands past _end, which breaks the Image layout and the
# !! phone reboots before the first printk.  #50 (working) has it off.
# CONFIG_DEBUG_INFO is not set
# CONFIG_BOEFFLA_WL_BLOCKER is not set

CONFIG_SCHED_CLASS_EXT=y
CONFIG_HMBIRD_SCHED=y
CONFIG_DEBUG_INFO_BTF=n
